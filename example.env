SERPAPI_KEY=Your SERPAPI_KEY
SILICONFLOW_API_KEY=

# Konfigurasi nama model (opsional, jika tidak disetel maka menggunakan nilai default)
# Nama model Ollama lokal
# OLLAMA_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
# Nama model cloud SiliconFlow
# SILICONFLOW_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B

# Konfigurasi model embedding
# Pilihan provider: sentence_transformers (default) atau ollama
# EMBEDDING_PROVIDER=sentence_transformers
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Jika ingin menggunakan Ollama nomic-embed-text:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL_NAME=nomic-embed-text
